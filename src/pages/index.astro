---
import BaseLayout from "../layouts/BaseLayout.astro";
import EventScheduleIcon from "../components/EventScheduleIcon.astro";
import Hero from "../components/Hero.astro";
import LoyaltySignupForm from "../components/LoyaltySignupForm.astro";
import Section from "../components/Section.astro";
import { LOYALTY_SIGNUP_ID } from "../data/business";
import { getFeaturedDishes, seasonalSpecials } from "../data/menu";
import { LOYALTY_PROGRAM_NAME } from "../data/loyalty-consent";

const featuredDishes = getFeaturedDishes();
---

<BaseLayout
  title="Home"
  description="Lonell's Soul Food Cuisine in South Los Angeles — authentic Southern soul food, live jazz, Sunday brunch with free champagne. Oxtails, fried chicken, catfish, and more. Black-owned. (323) 451-3104."
  ogImage="/og-home.jpg"
>
  <Hero />

  <!-- Summer specials — social / IG / TikTok landing hook -->
  <section class="section-padding py-8 md:py-10 bg-[var(--color-brand-amber)]/5 border-y border-[var(--color-brand-amber)]/20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="flex flex-col md:flex-row md:items-center gap-5 md:gap-8">
        <div class="flex-1">
          <span class="eyebrow text-[var(--color-brand-amber)]">{seasonalSpecials.season}</span>
          <h2 class="font-display text-2xl md:text-3xl font-bold mt-1 mb-2">{seasonalSpecials.title}</h2>
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
            {seasonalSpecials.schedule} · Plates from $12–$20 · {seasonalSpecials.note}
          </p>
        </div>
        <a
          href="/menu#seasonal-specials"
          class="shrink-0 inline-flex items-center justify-center px-8 py-3 bg-[var(--color-brand-amber)] text-black font-semibold rounded-full hover:bg-[var(--color-brand-amber-light)] transition-colors text-sm"
        >
          View Summer Menu
        </a>
      </div>
    </div>
  </section>

  <!-- About snapshot -->
  <Section eyebrow="About" title="Soul Food with a Side of Live Entertainment" description="Lonell's Soul Food Cuisine is one of the few soul food spots in Los Angeles that combines authentic, made-from-scratch cooking with consistent live entertainment, including jazz, karaoke, and Sunday brunch performances.">
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 bg-[var(--color-surface-card)] rounded-xl border border-[var(--color-border-subtle)] flex flex-col">
        <h3 class="font-display text-lg font-semibold mb-2">Authentic Soul Food</h3>
        <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-4">Oxtails, fried chicken, catfish, short ribs, and classic Southern sides. Every dish made from scratch with family recipes.</p>
        <a href="/menu" class="mt-auto inline-flex items-center gap-1.5 text-xs tracking-wider uppercase text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] transition-colors">
          View Menu
          <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="7" x2="11" y2="7" />
            <polyline points="7,3 11,7 7,11" />
          </svg>
        </a>
      </div>
      <div class="p-6 bg-[var(--color-surface-card)] rounded-xl border border-[var(--color-border-subtle)] flex flex-col">
        <h3 class="font-display text-lg font-semibold mb-2">Live Music Venue</h3>
        <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-4">Jazz Wednesdays & Fridays, Karaoke Saturdays, and Live Sunday Brunch. Dinner and a show every week.</p>
        <a href="/entertainment" class="mt-auto inline-flex items-center gap-1.5 text-xs tracking-wider uppercase text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] transition-colors">
          Entertainment
          <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="7" x2="11" y2="7" />
            <polyline points="7,3 11,7 7,11" />
          </svg>
        </a>
      </div>
      <div class="p-6 bg-[var(--color-surface-card)] rounded-xl border border-[var(--color-border-subtle)] flex flex-col">
        <h3 class="font-display text-lg font-semibold mb-2">Private Events</h3>
        <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-4">Two private event spaces (50 capacity each). Perfect for birthdays, corporate events, celebrations, and community gatherings.</p>
        <a href="/private-events" class="mt-auto inline-flex items-center gap-1.5 text-xs tracking-wider uppercase text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] transition-colors">
          Learn More
          <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="7" x2="11" y2="7" />
            <polyline points="7,3 11,7 7,11" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Key differentiator highlight -->
    <div class="mt-8 p-6 bg-[var(--color-surface-card)] rounded-xl border border-[var(--color-brand-amber)]/20 text-center">
      <p class="text-sm text-[var(--color-text-secondary)]">
        <span class="text-[var(--color-accent)] font-semibold">Proudly Black-owned</span> in the Vermont Knolls neighborhood of South Los Angeles. 
        4.2 stars on Yelp &middot; 7,400+ Instagram followers
      </p>
    </div>
  </Section>

  <!-- Signature Plates -->
  <Section eyebrow="The Menu" title="Signature Dinner Plates" description="Hearty entrees served with your choice of two classic Southern sides. Made from scratch, every day." class="bg-[var(--color-surface-card)]">
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        featuredDishes.map((dish) => (
          <a
            href="/menu#dinner-plates"
            class="group overflow-hidden rounded-xl border border-[var(--color-border-subtle)] bg-[var(--color-surface-base)] hover:border-[var(--color-brand-amber)]/40 transition-colors"
          >
            {
              dish.image && (
                <picture>
                  <source srcset={`${dish.image} 1x, ${dish.image.replace(".webp", "@2x.webp")} 2x`} type="image/webp" />
                  <img
                    src={dish.image.replace(".webp", ".jpg")}
                    alt={dish.imageAlt ?? `${dish.name} at Lonell's Soul Food`}
                    width={1024}
                    height={808}
                    class="w-full aspect-[4/3] object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              )
            }
            <div class="p-5">
              <h3 class="font-display text-lg font-semibold group-hover:text-[var(--color-accent)] transition-colors">{dish.name}</h3>
              <p class="text-sm text-[var(--color-text-secondary)] mt-1 leading-relaxed">{dish.description}</p>
              {dish.price && <p class="text-sm text-[var(--color-accent)] mt-3">{dish.price}</p>}
            </div>
          </a>
        ))
      }
    </div>
    <div class="mt-8 text-center">
      <a href="/menu" class="inline-flex items-center gap-2 text-xs tracking-wider uppercase text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] transition-colors">
        View Full Menu
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="7" x2="11" y2="7" />
          <polyline points="7,3 11,7 7,11" />
        </svg>
      </a>
    </div>
  </Section>

  <!-- Weekly Entertainment Schedule -->
  <Section eyebrow="This Week" title="Live Entertainment Schedule" description="Every week at Lonell's. Good food, good music, good vibes." class="bg-[var(--color-surface-card)]" wide>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
      <div class="event-card rounded-xl p-6 text-center">
        <div class="flex flex-col items-center gap-2 mb-4">
          <EventScheduleIcon type="jazz" />
          <span class="text-xs tracking-[0.15em] uppercase text-[var(--color-accent)]">Wednesday</span>
        </div>
        <h3 class="font-display text-lg font-semibold mb-1">Live Jazz</h3>
        <p class="text-sm text-[var(--color-text-secondary)]">6:00 PM – 9:00 PM</p>
      </div>
      <div class="event-card rounded-xl p-6 text-center">
        <div class="flex flex-col items-center gap-2 mb-4">
          <EventScheduleIcon type="comedy" />
          <span class="text-xs tracking-[0.15em] uppercase text-[var(--color-accent)]">3rd Thursday</span>
        </div>
        <h3 class="font-display text-lg font-semibold mb-1">Comedy Night</h3>
        <p class="text-sm text-[var(--color-text-secondary)]">7:00 PM – 9:00 PM</p>
      </div>
      <div class="event-card rounded-xl p-6 text-center">
        <div class="flex flex-col items-center gap-2 mb-4">
          <EventScheduleIcon type="jazz" />
          <span class="text-xs tracking-[0.15em] uppercase text-[var(--color-accent)]">Friday</span>
        </div>
        <h3 class="font-display text-lg font-semibold mb-1">Live Jazz</h3>
        <p class="text-sm text-[var(--color-text-secondary)]">6:00 PM – 9:00 PM</p>
      </div>
      <div class="event-card rounded-xl p-6 text-center">
        <div class="flex flex-col items-center gap-2 mb-4">
          <EventScheduleIcon type="karaoke" />
          <span class="text-xs tracking-[0.15em] uppercase text-[var(--color-accent)]">Saturday</span>
        </div>
        <h3 class="font-display text-lg font-semibold mb-1">Karaoke</h3>
        <p class="text-sm text-[var(--color-text-secondary)]">6:00 PM – 9:00 PM</p>
      </div>
      <div class="event-card rounded-xl p-6 text-center">
        <div class="flex flex-col items-center gap-2 mb-4">
          <EventScheduleIcon type="brunch" />
          <span class="text-xs tracking-[0.15em] uppercase text-[var(--color-accent)]">Sunday</span>
        </div>
        <h3 class="font-display text-lg font-semibold mb-1">Gospel Brunch</h3>
        <p class="text-sm text-[var(--color-text-secondary)]">1:00 PM – 5:00 PM</p>
      </div>
    </div>
    <div class="mt-6 text-center">
      <a href="/entertainment" class="inline-flex items-center gap-2 text-xs tracking-wider uppercase text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] transition-colors">
        Entertainment Schedule
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="7" x2="11" y2="7" />
          <polyline points="7,3 11,7 7,11" />
        </svg>
      </a>
    </div>
  </Section>

  <!-- Reservation & Contact CTA -->
  <Section eyebrow="Reserve" title="Book Your Table" description="Walk-ins welcome, reservations accepted for parties of any size. Call or email to reserve.">
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="tel:+13234513104" class="inline-flex items-center px-8 py-3 bg-[var(--color-accent)] text-black font-semibold rounded-full hover:bg-[var(--color-accent-hover)] transition-colors">
        Call (323) 451-3104
      </a>
      <a href="mailto:reservations@lonellssoulfood.com" class="inline-flex items-center px-8 py-3 border border-[var(--color-border)] text-[var(--color-text-primary)] rounded-full hover:bg-[var(--color-surface-hover)] transition-colors">
        Email reservations@lonellssoulfood.com
      </a>
      <a href="/contact" class="inline-flex items-center px-8 py-3 border border-[var(--color-border)] text-[var(--color-text-primary)] rounded-full hover:bg-[var(--color-surface-hover)] transition-colors">
        More Info
      </a>
    </div>
  </Section>

  <!-- Review highlight -->
  <Section eyebrow="What People Say" title="Rated 4.2 Stars" description="" class="bg-[var(--color-surface-card)]">
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 bg-[var(--color-surface-base)] rounded-xl border border-[var(--color-border-subtle)]">
        <div class="flex items-center gap-1 mb-3 text-[var(--color-accent)]">
          {"★".repeat(5)}
        </div>
        <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-4 italic">"This will be the new spot to catch up with my friend! We both ordered oxtails; divine tender well seasoned."</p>
      </div>
      <div class="p-6 bg-[var(--color-surface-base)] rounded-xl border border-[var(--color-border-subtle)]">
        <div class="flex items-center gap-1 mb-3 text-[var(--color-accent)]">
          {"★".repeat(5)}
        </div>
        <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-4 italic">"Absolutely Delightful! Parking a breeze on the street."</p>
      </div>
      <div class="p-6 bg-[var(--color-surface-base)] rounded-xl border border-[var(--color-border-subtle)]">
        <div class="flex items-center gap-1 mb-3 text-[var(--color-accent)]">
          {"★".repeat(5)}
        </div>
        <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-4 italic">"Met my foodie friend there and we were completely pleased with the service, the music, the food."</p>
      </div>
    </div>
    <div class="mt-6 text-center">
      <a href="/reviews" class="inline-flex items-center gap-2 text-xs tracking-wider uppercase text-[var(--color-accent)] hover:text-white transition-colors">
        Read More Reviews
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="7" x2="11" y2="7" />
          <polyline points="7,3 11,7 7,11" />
        </svg>
      </a>
    </div>
  </Section>

  <Section
    id={LOYALTY_SIGNUP_ID}
    eyebrow="Join the Fam"
    title={LOYALTY_PROGRAM_NAME}
    className="text-center bg-[var(--color-surface-card)]"
  >
    <div class="mt-8 p-6 md:p-8 bg-[var(--color-surface-base)] rounded-xl border border-[var(--color-neon-subtle)] neon-glow max-w-lg mx-auto text-left">
      <LoyaltySignupForm />
    </div>
  </Section>
</BaseLayout>
