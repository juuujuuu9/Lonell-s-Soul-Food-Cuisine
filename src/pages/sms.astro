---
import BaseLayout from "../layouts/BaseLayout.astro";
import LoyaltySignupForm from "../components/LoyaltySignupForm.astro";
import {
  LOYALTY_KEYWORD,
  LOYALTY_SMS_DISPLAY,
  LOYALTY_SMS_NUMBER,
} from "../data/business";
import {
  LOYALTY_MESSAGE_FREQUENCY,
  LOYALTY_PROGRAM_NAME,
} from "../data/loyalty-consent";
---

<BaseLayout
  title="Join Our SMS Club"
  description={`Join ${LOYALTY_PROGRAM_NAME}: text ${LOYALTY_KEYWORD} to ${LOYALTY_SMS_DISPLAY}, or opt in online with an unchecked consent checkbox.`}
  noindex
>
  <div class="min-h-screen flex flex-col items-center px-4 py-16 text-center">
    <div class="mx-auto w-full max-w-md">
      <span class="eyebrow" data-reveal>Stay Connected</span>
      <h1 class="font-display mt-2 mb-4 text-3xl font-bold md:text-4xl" data-reveal>
        Join Our SMS Club
      </h1>
      <p class="mb-8 leading-relaxed text-[var(--color-text-secondary)]" data-reveal>
        Get recurring automated marketing texts with exclusive offers, menu previews, event
        invitations, and loyalty rewards. Show your welcome text for
        <strong class="text-[var(--color-accent)]">10% off your dinner</strong>.
      </p>

      <div
        class="mb-8 rounded-xl border border-[var(--color-brand-amber)]/20 bg-[var(--color-surface-card)] p-6"
        data-reveal
        id="keyword-cta"
      >
        <p class="mb-3 text-sm text-[var(--color-text-secondary)]">
          Option A — Text the keyword to our SMS number:
        </p>
        <p class="mb-1 font-display text-2xl font-bold tracking-wider text-[var(--color-brand-amber)]">
          {LOYALTY_KEYWORD}
        </p>
        <p class="mb-4 text-lg text-[var(--color-text-primary)]">{LOYALTY_SMS_DISPLAY}</p>
        <img
          src="/media/qrcodes/qr-sms-optin.png"
          alt={`QR code to text ${LOYALTY_KEYWORD} to ${LOYALTY_SMS_DISPLAY}`}
          width="140"
          height="140"
          class="mx-auto mb-4 rounded-lg bg-white p-2"
        />
        <a
          id="sms-link"
          href={`sms:${LOYALTY_SMS_NUMBER}?body=${encodeURIComponent(LOYALTY_KEYWORD)}`}
          class="inline-flex w-full items-center justify-center rounded-full bg-[var(--color-accent)] px-8 py-3 text-sm font-semibold text-black transition-colors hover:bg-[var(--color-accent-hover)] sm:w-auto"
        >
          Open Messenger
        </a>
        <p class="mt-4 text-left text-xs leading-relaxed text-[var(--color-text-muted)]">
          By texting {LOYALTY_KEYWORD} you agree to receive recurring automated marketing texts from
          Lonell&apos;s Soul Food Cuisine. Msg &amp; data rates may apply. Message frequency varies
          ({LOYALTY_MESSAGE_FREQUENCY}). Consent is not a condition of purchase. Reply STOP to cancel,
          HELP for help.
        </p>
      </div>

      <div
        class="mb-8 rounded-xl border border-[var(--color-neon-subtle)] bg-[var(--color-surface-card)] p-6 text-left neon-glow"
        data-reveal
        id="web-form-cta"
      >
        <p class="mb-4 text-center text-sm text-[var(--color-text-secondary)]">
          Option B — Opt in on this page (checkbox unchecked by default):
        </p>
        <LoyaltySignupForm />
      </div>

      <div class="space-y-3 text-xs text-[var(--color-text-muted)]" data-reveal>
        <p>
          <a href="/terms#sms-program" class="text-[var(--color-brand-amber)] underline hover:no-underline">Terms</a>
          {" · "}
          <a href="/privacy#sms-privacy" class="text-[var(--color-brand-amber)] underline hover:no-underline">Privacy Policy</a>
          {" · "}
          <a href="/a2p-opt-in-proof" class="text-[var(--color-brand-amber)] underline hover:no-underline">Opt-in proof</a>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const isMobile = /Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
  if (isMobile) {
    const link = document.getElementById("sms-link");
    if (link) {
      setTimeout(() => {
        link.click();
      }, 600);
    }
  }
</script>
