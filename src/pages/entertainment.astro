---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import EventCard from "../components/EventCard.astro";

const weeklyEvents = [
  {
    title: "Comedy Night",
    date: "3rd Thursday Monthly",
    type: "comedy" as const,
    description: "Laugh the night away at our monthly Comedy Night! Dinner service runs 11am-7pm, then the comedians take the stage from 7pm to 9pm on the 3rd Thursday of every month.",
    href: "#reserve",
    cta: "Reserve a Table",
  },
  {
    title: "Live Jazz Fridays",
    date: "Every Friday",
    type: "jazz" as const,
    description: "End your week on a high note. Live jazz from 6pm to 9pm while you enjoy your favorite soul food classics. Extended hours until 9pm.",
    href: "#reserve",
    cta: "Reserve Your Table",
  },
  {
    title: "Karaoke Saturdays",
    date: "Every Saturday",
    type: "karaoke" as const,
    description: "Grab the mic and sing your heart out! Karaoke from 6pm to 9pm with DJ Goddess Divine. Great food, great vibes, great company.",
    href: "#reserve",
    cta: "Come Through",
  },
];

const blackRestaurantWeek = {
  name: "Los Angeles Black Restaurant Week",
  startDate: "2026-09-18",
  endDate: "2026-09-27",
  dateRangeLabel: "September 18–27, 2026",
};
---

<!-- Event schema -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Event",
      "name": "Comedy Night — 3rd Thursday",
      "description": "Monthly comedy night on the 3rd Thursday at Lonell's Soul Food. Dinner served 11am-7pm, comedy 7-9pm.",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": { "@type": "Place", "name": "Lonell's Soul Food Cuisine", "address": "8501 S Vermont Ave, Los Angeles, CA 90044" },
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
    },
    {
      "@type": "Event",
      "name": "Live Jazz Friday",
      "description": "Live jazz music every Friday at Lonell's. Dinner served 11am-9pm, music 6-9pm.",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": { "@type": "Place", "name": "Lonell's Soul Food Cuisine", "address": "8501 S Vermont Ave, Los Angeles, CA 90044" },
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
    },
    {
      "@type": "Event",
      "name": "Karaoke Saturday",
      "description": "Karaoke night every Saturday at Lonell's Soul Food, hosted by DJ Goddess Divine. Dinner served 11am-9pm, karaoke 6-9pm.",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": { "@type": "Place", "name": "Lonell's Soul Food Cuisine", "address": "8501 S Vermont Ave, Los Angeles, CA 90044" },
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
    },
    {
      "@type": "Event",
      "name": blackRestaurantWeek.name,
      "description": "Lonell's Soul Food Cuisine is a participating restaurant during LA Black Restaurant Week, a citywide celebration of Black-owned dining in Los Angeles.",
      "startDate": blackRestaurantWeek.startDate,
      "endDate": blackRestaurantWeek.endDate,
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": { "@type": "Place", "name": "Lonell's Soul Food Cuisine", "address": "8501 S Vermont Ave, Los Angeles, CA 90044" },
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
    }
  ]
})}></script>

<BaseLayout title="Entertainment" description="Live Jazz Fridays and Karaoke Saturdays at Lonell's Soul Food in South Los Angeles, plus Sunday Brunch with free champagne. A cultural hub for food, music, and community.">
  <div class="min-h-screen pb-16">
    <!-- LA Black Restaurant Week feature -->
    <section id="black-restaurant-week" class="section-padding pb-0">
      <div class="max-w-4xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center p-6 md:p-8 bg-[var(--color-surface-card)] rounded-xl border border-[var(--color-brand-amber)]/20">
          <picture class="block overflow-hidden rounded-xl border border-[var(--color-border-subtle)] order-first md:order-last">
            <source
              srcset="/media/images/la-black-restaurant-week-2026.webp 1x, /media/images/la-black-restaurant-week-2026@2x.webp 2x"
              type="image/webp"
            />
            <img
              src="/media/images/la-black-restaurant-week-2026.jpg"
              alt="LA Black Restaurant Week flyer, September 18–27, 2026"
              width="642"
              height="720"
              class="w-full h-auto object-cover"
              loading="lazy"
            />
          </picture>
          <div>
            <span class="eyebrow text-[var(--color-brand-amber)]" data-reveal>Happening Now</span>
            <h2 class="font-display text-2xl md:text-3xl font-bold mt-2 mb-3" data-reveal>LA Black Restaurant Week</h2>
            <p class="text-sm md:text-base text-[var(--color-text-secondary)] leading-relaxed mb-6" data-reveal>
              Lonell's is a proud participating restaurant in Los Angeles Black Restaurant Week, {blackRestaurantWeek.dateRangeLabel} — 
              a citywide celebration honoring Black-owned dining across LA. Come out during the week to enjoy Chef Lonell's soul food and support Black-owned business.
            </p>
            <a href="#reserve" class="inline-flex items-center justify-center px-8 py-3 bg-[var(--color-brand-amber)] text-black font-semibold rounded-full hover:bg-[var(--color-brand-amber-light)] transition-colors text-sm w-full sm:w-auto text-center">
              Reserve a Table
            </a>
          </div>
        </div>
      </div>
    </section>

    <Section eyebrow="Come Through" title="Entertainment Schedule" description="Lonell's is one of the only soul food restaurants in Los Angeles with consistent live entertainment every week — a cultural hub where food, music, and community come together." wide>
      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
        {weeklyEvents.map((event) => (
          <EventCard {...event} />
        ))}
      </div>

      <!-- Karaoke Saturdays flier -->
      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-8 items-center p-6 md:p-8 bg-[var(--color-surface-card)] rounded-xl border border-[var(--color-border-subtle)]">
        <div>
          <span class="eyebrow" data-reveal>Every Saturday, 6–9 PM</span>
          <h3 class="font-display text-xl md:text-2xl font-semibold mt-2 mb-3" data-reveal>Karaoke Saturdays with DJ Goddess Divine</h3>
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed" data-reveal>
            DJ Goddess Divine hosts the mic every Saturday from 6:00 PM to 9:00 PM. Grab a plate, grab a mic, 
            and sing your heart out at 8501 S Vermont Ave.
          </p>
        </div>
        <picture class="block overflow-hidden rounded-xl border border-[var(--color-border-subtle)]">
          <source
            srcset="/media/images/karaoke-saturdays-flier.webp 1x, /media/images/karaoke-saturdays-flier@2x.webp 2x"
            type="image/webp"
          />
          <img
            src="/media/images/karaoke-saturdays-flier.jpg"
            alt="Karaoke Saturdays flyer, 6:00-9:00 PM with DJ Goddess Divine at Lonell's Soul Food Cuisine"
            width="670"
            height="1024"
            class="w-full h-auto object-cover"
            loading="lazy"
          />
        </picture>
      </div>

      <!-- Weekly Schedule Summary -->
      <div id="schedule" class="mt-16 p-4 md:p-8 bg-[var(--color-surface-card)] rounded-xl border border-[var(--color-border-subtle)]">
        <h3 class="font-display text-2xl font-semibold mb-6 text-center" data-reveal>At a Glance</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-[var(--color-border-subtle)]">
                <th class="text-left py-3 pr-4 text-xs tracking-[0.15em] uppercase text-[var(--color-text-muted)]">Day</th>
                <th class="text-left py-3 pr-4 text-xs tracking-[0.15em] uppercase text-[var(--color-text-muted)]">Hours</th>
                <th class="text-left py-3 text-xs tracking-[0.15em] uppercase text-[var(--color-text-muted)]">Entertainment</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-[var(--color-border-subtle)]">
                <td class="py-3 pr-4 font-medium">Monday</td>
                <td class="py-3 pr-4 text-[var(--color-text-muted)]">CLOSED</td>
                <td class="py-3 text-[var(--color-text-muted)]">&mdash;</td>
              </tr>
              <tr class="border-b border-[var(--color-border-subtle)]">
                <td class="py-3 pr-4 font-medium">Tuesday</td>
                <td class="py-3 pr-4">11:00 AM – 7:00 PM <span class="text-[var(--color-text-muted)] text-xs">(take-out only)</span></td>
                <td class="py-3 text-[var(--color-text-muted)]">&mdash;</td>
              </tr>
              <tr class="border-b border-[var(--color-border-subtle)]">
                <td class="py-3 pr-4 font-medium">Wednesday</td>
                <td class="py-3 pr-4">11:00 AM – 7:00 PM <span class="text-[var(--color-text-muted)] text-xs">(take-out only)</span></td>
                <td class="py-3 text-[var(--color-text-muted)]">&mdash;</td>
              </tr>
              <tr class="border-b border-[var(--color-border-subtle)]">
                <td class="py-3 pr-4 font-medium">Thursday</td>
                <td class="py-3 pr-4">11:00 AM – 7:00 PM <span class="text-[var(--color-text-muted)] text-xs">(full service)</span></td>
                <td class="py-3 text-[var(--color-neon)]">Comedy Night 7:00 PM – 9:00 PM (3rd Thursday)</td>
              </tr>
              <tr class="border-b border-[var(--color-border-subtle)]">
                <td class="py-3 pr-4 font-medium">Friday</td>
                <td class="py-3 pr-4">11:00 AM – 9:00 PM <span class="text-[var(--color-text-muted)] text-xs">(full service)</span></td>
                <td class="py-3 text-[var(--color-neon)]">Live Jazz 6:00 PM – 9:00 PM</td>
              </tr>
              <tr>
                <td class="py-3 pr-4 font-medium">Saturday</td>
                <td class="py-3 pr-4">11:00 AM – 9:00 PM <span class="text-[var(--color-text-muted)] text-xs">(full service)</span></td>
                <td class="py-3 text-[var(--color-neon)]">Karaoke 6:00 PM – 9:00 PM with DJ Goddess Divine</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="mt-6 p-4 bg-[var(--color-surface-base)] rounded-lg border border-[var(--color-border-subtle)]">
          <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
            <span class="text-[var(--color-accent)] font-semibold">Sunday Brunch Special:</span> Free champagne with brunch. 10% Senior &amp; Government Worker Discount (valid ID required).
          </p>
        </div>
      </div>
    </Section>

    <!-- Cultural hub framing -->
    <section class="section-padding">
      <div class="max-w-4xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
          <div>
            <span class="eyebrow" data-reveal>The Experience</span>
            <h2 class="font-display text-3xl md:text-4xl font-bold mt-2 mb-4" data-reveal>More Than a Restaurant</h2>
            <p class="text-[var(--color-text-secondary)] leading-relaxed mb-4" data-reveal>
              Lonell's was built to be a cultural and social hub where guests can enjoy meaningful moments — 
              unwinding to the soothing sounds of the best jazz bands in town, sharing expertly crafted 
              dishes with friends, or grabbing brunch on a Sunday morning.
            </p>
            <p class="text-[var(--color-text-secondary)] leading-relaxed" data-reveal>
              A dedicated performance stage serves as the focal point of the dining room, with live 
              entertainment every Friday and Saturday, plus the 3rd Thursday for Comedy Night. Whether it's a date night, 
              a gathering with friends, or a solo escape to recharge — Lonell's is the spot.
            </p>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="p-5 bg-[var(--color-surface-card)] rounded-xl border border-[var(--color-border-subtle)] text-center">
              <p class="font-display text-3xl font-bold text-[var(--color-accent)]">2</p>
              <p class="text-xs tracking-wider uppercase text-[var(--color-text-muted)] mt-1">Nights of Weekly Entertainment</p>
            </div>
            <div class="p-5 bg-[var(--color-surface-card)] rounded-xl border border-[var(--color-border-subtle)] text-center">
              <p class="font-display text-3xl font-bold text-[var(--color-accent)]">30+</p>
              <p class="text-xs tracking-wider uppercase text-[var(--color-text-muted)] mt-1">Years of Culinary Excellence</p>
            </div>
            <div class="p-5 bg-[var(--color-surface-card)] rounded-xl border border-[var(--color-border-subtle)] text-center">
              <p class="font-display text-3xl font-bold text-[var(--color-accent)]">1</p>
              <p class="text-xs tracking-wider uppercase text-[var(--color-text-muted)] mt-1">Dedicated Performance Stage</p>
            </div>
            <div class="p-5 bg-[var(--color-surface-card)] rounded-xl border border-[var(--color-border-subtle)] text-center">
              <p class="font-display text-3xl font-bold text-[var(--color-accent)]">Free</p>
              <p class="text-xs tracking-wider uppercase text-[var(--color-text-muted)] mt-1">Champagne at Sunday Brunch</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="reserve" class="section-padding">
      <div class="max-w-4xl mx-auto text-center">
        <span class="eyebrow" data-reveal>Reserve</span>
        <h2 class="font-display text-3xl md:text-4xl font-bold mb-4" data-reveal>Book Your Table</h2>
        <p class="text-[var(--color-text-secondary)] max-w-xl mx-auto mb-6 leading-relaxed" data-reveal>
          Walk-ins welcome, reservations accepted for parties of any size. Call or email to reserve.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="tel:+13234513104" class="inline-flex items-center justify-center px-8 py-3 bg-[var(--color-accent)] text-black font-semibold rounded-full hover:bg-[var(--color-accent-hover)] transition-colors w-full sm:w-auto text-center">
            Call (323) 451-3104
          </a>
          <a href="mailto:reservations@lonellssoulfood.com" class="inline-flex items-center justify-center px-8 py-3 border border-[var(--color-border)] text-[var(--color-text-primary)] rounded-full hover:bg-[var(--color-surface-hover)] transition-colors w-full sm:w-auto text-center">
            Email reservations@lonellssoulfood.com
          </a>
          <a href="/contact" class="inline-flex items-center justify-center px-8 py-3 border border-[var(--color-border)] text-[var(--color-text-primary)] rounded-full hover:bg-[var(--color-surface-hover)] transition-colors w-full sm:w-auto text-center">
            More Info
          </a>
        </div>
      </div>
    </section>

    <!-- Sunday Brunch highlight -->
    <section class="section-padding bg-[var(--color-surface-card)]">
      <div class="max-w-4xl mx-auto text-center">
        <span class="eyebrow" data-reveal>Every Sunday</span>
        <h2 class="font-display text-3xl md:text-4xl font-bold mb-4" data-reveal>Sunday Brunch</h2>
        <p class="text-[var(--color-text-secondary)] max-w-2xl mx-auto mb-6 leading-relaxed" data-reveal>
          Every Sunday, Lonell's serves up brunch from 11am–5pm with soul food favorites that resonate 
          with the community's love for comforting, hearty meals. No live music on Sundays — 
          free champagne is included with your brunch, and a 10% discount is available for seniors and 
          government workers with valid ID.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="tel:+13234513104" class="inline-flex items-center justify-center px-8 py-3 bg-[var(--color-accent)] text-black font-semibold rounded-full hover:bg-[var(--color-accent-hover)] transition-colors w-full sm:w-auto text-center">
            Reserve Your Spot
          </a>
          <a href="/menu" class="inline-flex items-center justify-center px-8 py-3 border border-[var(--color-border)] text-[var(--color-text-primary)] rounded-full hover:bg-[var(--color-surface-hover)] transition-colors w-full sm:w-auto text-center">
            View Menu
          </a>
        </div>
      </div>
    </section>

    <!-- Private Events summary -->
    <section class="section-padding">
      <div class="max-w-4xl mx-auto text-center">
        <span class="eyebrow" data-reveal>Host With Us</span>
        <h2 class="font-display text-3xl md:text-4xl font-bold mb-4" data-reveal>Private Events</h2>
        <p class="text-[var(--color-text-secondary)] max-w-xl mx-auto mb-6 leading-relaxed" data-reveal>
          Two private event spaces available, the Dining Room and Small Room, each with a maximum capacity of 50 guests. 
          Perfect for birthdays, anniversaries, corporate dinners, and community gatherings.
        </p>
        <a href="/private-events" class="inline-flex items-center justify-center px-8 py-3 bg-[var(--color-accent)] text-black font-semibold rounded-full hover:bg-[var(--color-accent-hover)] transition-colors w-full sm:w-auto text-center">
          Learn More & Book
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
