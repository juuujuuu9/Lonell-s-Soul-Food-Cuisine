---
import BaseLayout from "../layouts/BaseLayout.astro";
import LoyaltySignupForm from "../components/LoyaltySignupForm.astro";
import { LOYALTY_PROGRAM_NAME } from "../data/loyalty-consent";
---

<BaseLayout
  title="Join SoulFood SMS Club"
  noindex
  description="Join Lonell's Soul Food SMS Club for exclusive offers, menu previews, event invitations, and loyalty rewards."
>
  <div class="min-h-screen flex items-center justify-center px-4 py-16">
    <div class="w-full max-w-md">
      <div class="p-8 bg-[var(--color-surface-card)] rounded-xl border border-[var(--color-neon-subtle)] neon-glow">
        <p class="text-xs tracking-[0.15em] uppercase text-[var(--color-neon)] mb-2 text-center">
          {LOYALTY_PROGRAM_NAME}
        </p>
        <h1 class="font-display text-2xl font-bold mb-6 leading-tight text-center">
          Join the SoulFood Fam
        </h1>
        <LoyaltySignupForm />
        <a
          href="/"
          class="inline-block mt-6 w-full text-center text-xs text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors"
        >
          No thanks, I&apos;ll skip texts — take me back to lonellssoulfood.com
        </a>
        <p class="mt-2 text-center text-[11px] text-[var(--color-text-muted)]">
          Skipping is completely fine — you can still dine in, order takeout, or book a reservation
          without joining.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
