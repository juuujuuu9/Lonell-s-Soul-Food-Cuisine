---
import BaseLayout from "../layouts/BaseLayout.astro";
import ImageLightboxGallery from "../components/ImageLightboxGallery.astro";
import Section from "../components/Section.astro";
import type { PageHeaderBackground } from "../components/PageHeader.astro";
import { MANAGER_PHONE, MANAGER_PHONE_TEL } from "../data/business";
import {
  foodPhotos,
  MENU_EFFECTIVE_DATE,
  menuSections,
  seasonalSpecials,
  type MenuSectionItem,
} from "../data/menu";

const menuPhotos = [
  {
    webp: "/media/images/bar-daytime.webp",
    webp2x: "/media/images/bar-daytime@2x.webp",
    jpg: "/media/images/bar-daytime.jpg",
    full: "/media/images/bar-daytime@2x.webp",
    width: 1024,
    height: 767,
    alt: "Lonell's Soul Food bar and dining area during the day",
  },
  {
    webp: "/media/images/dining-from-rear.webp",
    webp2x: "/media/images/dining-from-rear@2x.webp",
    jpg: "/media/images/dining-from-rear.jpg",
    full: "/media/images/dining-from-rear@2x.webp",
    width: 768,
    height: 1024,
    alt: "Full dining room view with bar seating and chandelier",
  },
  {
    webp: "/media/images/interior-dining.webp",
    webp2x: "/media/images/interior-dining@2x.webp",
    jpg: "/media/images/interior-dining.jpg",
    full: "/media/images/interior-dining@2x.webp",
    width: 767,
    height: 1024,
    alt: "Dining room with natural light, orchid centerpieces, and woven pendant lighting",
  },
  {
    webp: "/media/images/side-tables-dining.webp",
    webp2x: "/media/images/side-tables-dining@2x.webp",
    jpg: "/media/images/side-tables-dining.jpg",
    full: "/media/images/side-tables-dining@2x.webp",
    width: 767,
    height: 1024,
    alt: "Booth seating with leather banquette and table lamps",
  },
  {
    webp: "/media/images/bar-pitchers.webp",
    webp2x: "/media/images/bar-pitchers@2x.webp",
    jpg: "/media/images/bar-pitchers.jpg",
    full: "/media/images/bar-pitchers@2x.webp",
    width: 1024,
    height: 731,
    alt: "Beverage dispensers with water, iced tea, and fruit punch at the bar",
  },
  {
    webp: "/media/images/bar-far-end.webp",
    webp2x: "/media/images/bar-far-end@2x.webp",
    jpg: "/media/images/bar-far-end.jpg",
    full: "/media/images/bar-far-end@2x.webp",
    width: 767,
    height: 1024,
    alt: "Counter seating with beverage dispensers and Lonell's Soul Food Cafe logo",
  },
];

const menuHeaderBackgrounds: PageHeaderBackground[] = foodPhotos.map((photo) => ({
  webp: photo.webp,
  webp2x: photo.webp2x,
  jpg: photo.jpg,
  alt: photo.alt,
}));

const SEASONAL_ID = "seasonal-specials";

const categoryIcons: Record<string, string> = {
  [SEASONAL_ID]: "sun",
  "lunch-plates": "clock",
  "dinner-plates": "moon",
  "a-la-carte": "drumstick",
  sides: "bowl",
  desserts: "cake",
  beverages: "cup",
};

const categoryDescriptions: Record<string, string> = {
  [SEASONAL_ID]: "Wed–Fri express plates",
  "lunch-plates": "11am – 3pm plates",
  "dinner-plates": "Evening entrees",
  "a-la-carte": "Protein only",
  sides: "Classic Southern sides",
  desserts: "Sweet finales",
  beverages: "Refreshments",
};

const navCategories = [
  {
    id: SEASONAL_ID,
    name: "Summer Specials",
    description: categoryDescriptions[SEASONAL_ID],
    icon: categoryIcons[SEASONAL_ID],
    itemCount: seasonalSpecials.groups.reduce((n, g) => n + g.items.length, 0),
  },
  ...menuSections.map((section) => ({
    id: section.id,
    name: section.name,
    description: categoryDescriptions[section.id] ?? "",
    icon: categoryIcons[section.id] ?? "bowl",
    itemCount: section.items.length,
  })),
];

const iconPaths: Record<string, string> = {
  clock: '<path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2z"/><path d="M12 6v6l4 2"/>',
  sun: '<circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke-width="2" fill="none"/>',
  moon: '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" fill="none"/>',
  drumstick: '<path d="M15.5 3.5a5 5 0 0 1 5 5c0 2.5-1.5 4.5-3.5 5.5L12 19l-3-3 5.5-5.5c1-2 .5-4.5-1-6s-3.5-2-5-1l-2 2 3 3-2 2-3-3-2 2 3 3-2 2-3-3L2 12c-1 1.5-.5 3.5 1 5s3.5 2 5 1l1.5-1.5" fill="none"/>',
  bowl: '<path d="M2 12c0 5.523 4.477 10 10 10s10-4.477 10-10"/><path d="M2 12h20"/><path d="M6 8c0-2 1.5-4 4-4 1.5 0 2.5.5 3 1.5" fill="none"/><path d="M18 8c0-2-1.5-4-4-4-1.5 0-2.5.5-3 1.5" fill="none"/>',
  cake: '<path d="M4 16h16v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-5z"/><path d="M4 12h16v4H4z"/><path d="M4 10V8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2"/><path d="M8 6V4"/><path d="M12 6V3"/><path d="M16 6V4"/>',
  cup: '<path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><path d="M6 1v3M10 1v3M14 1v3" fill="none"/>',
};

const priceToSchema = (price: string) => price.replace(/[^0-9.]/g, "");

const toSchemaItem = (item: MenuSectionItem) => {
  const entry: Record<string, unknown> = {
    "@type": "MenuItem",
    name: item.name,
  };
  const description = [item.description, item.note].filter(Boolean).join(". ");
  if (description) entry.description = description;
  if (item.price) {
    entry.offers = {
      "@type": "Offer",
      price: priceToSchema(item.price),
      priceCurrency: "USD",
    };
  }
  return entry;
};

const schemaItems = [
  ...seasonalSpecials.groups.flatMap((group) => group.items.map(toSchemaItem)),
  ...menuSections.flatMap((section) => section.items.map(toSchemaItem)),
];
---

<!-- Menu schema — generated from src/data/menu.ts -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Menu",
  "name": "Lonell's Soul Food Cuisine Menu",
  "description": `Effective ${MENU_EFFECTIVE_DATE}. Lunch and dinner plates with sides, seasonal specials, a la carte, sides, desserts, and beverages.`,
  "hasMenuItem": schemaItems,
})}></script>

<BaseLayout title="Menu" ogImage="/og-menu.jpg" headerBackgrounds={menuHeaderBackgrounds}>
  <div class="min-h-screen pb-16">
    <Section
      eyebrow="A Place of Love"
      title="Our Menu"
      description="Lunch plates (11am–3pm) and dinner plates include 2 sides & cornbread. Dine-in, takeout, or call ahead. Menu updates seasonally as supply allows."
      class="menu-page-section"
    >
      <div class="flex flex-wrap items-center gap-3 mt-2 mb-4">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium tracking-wide uppercase bg-[var(--color-brand-amber)]/15 text-[var(--color-brand-amber)] border border-[var(--color-brand-amber)]/30">
          Effective {MENU_EFFECTIVE_DATE}
        </span>
        <span class="text-xs text-[var(--color-text-muted)]">{seasonalSpecials.season}</span>
      </div>
      <div class="mb-8">
        <a
          href={`tel:${MANAGER_PHONE_TEL}`}
          class="inline-flex items-center justify-center px-6 py-3 bg-[var(--color-brand-amber)] text-black font-semibold rounded-full hover:bg-[var(--color-brand-amber-light)] transition-colors text-sm"
        >
          Call to Order · {MANAGER_PHONE}
        </a>
      </div>

      <!-- Bento Quick-Select Grid -->
      <div id="bento-grid" class="mb-12">
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4">
          {navCategories.map((category) => (
            <button
              data-bento-card
              data-category={category.id}
              class="group relative flex flex-col items-start justify-between p-4 md:p-5 rounded-xl bg-[var(--color-surface-card)] border border-[var(--color-border-subtle)] hover:border-[var(--color-brand-amber)]/40 hover:shadow-[0_0_24px_rgba(245,158,11,0.12)] transition-all duration-300 text-left cursor-pointer"
              aria-label={`Jump to ${category.name}`}
            >
              <span class="mb-3 text-[var(--color-brand-amber)] w-7 h-7 md:w-8 md:h-8" aria-hidden="true">
                <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none" class="w-full h-full">
                  <Fragment set:html={iconPaths[category.icon]} />
                </svg>
              </span>
              <div>
                <span class="block font-display text-sm md:text-base font-semibold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent)] transition-colors">
                  {category.name}
                </span>
                <span class="block text-xs text-[var(--color-text-muted)] mt-0.5">
                  {category.description}
                </span>
                <span class="inline-block mt-2 text-[10px] font-medium tracking-wider uppercase text-[var(--color-brand-amber)]/70">
                  {category.itemCount} {category.itemCount === 1 ? "item" : "items"}
                </span>
              </div>
            </button>
          ))}
        </div>
      </div>

      <!-- Sticky Category Pill Bar -->
      <div
        id="category-pill-bar"
        class="fixed left-0 right-0 z-[105] opacity-0 pointer-events-none transition-opacity duration-300"
        style="top: calc(3.5rem + 0px);"
        role="tablist"
        aria-label="Menu categories"
      >
        <div class="bg-[var(--color-surface-card)]/90 backdrop-blur-md border-b border-[var(--color-border-subtle)]">
          <div class="w-full py-2.5 px-4 md:px-6 lg:flex lg:justify-center">
            <nav class="flex gap-1.5 xl:gap-2 overflow-x-auto hide-scrollbar w-full max-w-full lg:w-auto lg:inline-flex lg:overflow-x-visible" role="tablist">
              {navCategories.map((category) => (
                <button
                  data-pill
                  data-category={category.id}
                  class="shrink-0 px-3 py-1.5 rounded-full text-[10px] sm:text-[11px] font-display font-semibold tracking-wide uppercase leading-none whitespace-nowrap border transition-all duration-300 cursor-pointer
                    border-[var(--color-border-subtle)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:border-[var(--color-border)]
                    active:bg-[var(--color-surface-hover)] inline-flex items-center justify-center text-center
                    xl:px-3 xl:py-2 xl:text-xs xl:tracking-wider"
                  role="tab"
                  aria-selected="false"
                >
                  {category.name}
                </button>
              ))}
            </nav>
          </div>
        </div>
      </div>

      <div class="mt-12 space-y-16">
        <!-- Seasonal Specials -->
        <div id={SEASONAL_ID} data-category-section style="scroll-margin-top: 8rem;">
          <div class="p-6 md:p-8 rounded-xl border border-[var(--color-brand-amber)]/30 bg-[var(--color-brand-amber)]/5">
            <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3 mb-2">
              <h3 class="font-display text-2xl font-semibold text-[var(--color-accent)]">{seasonalSpecials.title}</h3>
              <span class="text-xs tracking-[0.1em] uppercase text-[var(--color-text-muted)]">{seasonalSpecials.schedule}</span>
            </div>
            <p class="text-sm text-[var(--color-text-secondary)] mb-6">{seasonalSpecials.note}</p>
            <div class="space-y-10">
              {seasonalSpecials.groups.map((group) => (
                <div>
                  <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3 mb-4">
                    <h4 class="font-display text-lg font-semibold text-[var(--color-text-primary)]">{group.name}</h4>
                    {group.subtitle && (
                      <span class="text-xs tracking-[0.1em] uppercase text-[var(--color-text-muted)]">{group.subtitle}</span>
                    )}
                  </div>
                  <div class="space-y-4">
                    {group.items.map((item) => (
                      <div class="flex justify-between items-start gap-4 pb-4 border-b border-[var(--color-border-subtle)] last:border-0">
                        <div>
                          <p class="font-display text-base font-medium">{item.name}</p>
                          {item.description && (
                            <p class="text-sm text-[var(--color-text-secondary)] mt-0.5">{item.description}</p>
                          )}
                        </div>
                        {item.price && (
                          <span class="text-sm text-[var(--color-accent)] whitespace-nowrap font-medium">{item.price}</span>
                        )}
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Regular menu sections -->
        {menuSections.map((section) => (
          <div id={section.id} data-category-section style="scroll-margin-top: 8rem;">
            <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3 mb-6">
              <h3 class="font-display text-2xl font-semibold text-[var(--color-accent)]">{section.name}</h3>
              {section.subtitle && (
                <span class="text-xs tracking-[0.1em] uppercase text-[var(--color-text-muted)]">{section.subtitle}</span>
              )}
            </div>
            {section.id === "dinner-plates" && (
              <div class="mb-8">
                <ImageLightboxGallery photos={foodPhotos} mobileCarousel layout="row5" />
              </div>
            )}
            {section.id === "beverages" && (
              <p class="text-sm text-[var(--color-text-secondary)] mb-6">
                We also offer a curated selection of <strong class="text-[var(--color-text-primary)]">beer and wine</strong>.
                Ask your server for today's selection. A full bar with cocktails is coming soon.
              </p>
            )}
            <div class="space-y-6">
              {section.items.map((item) => (
                <div class="flex justify-between items-start gap-4 pb-6 border-b border-[var(--color-border-subtle)] last:border-0">
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                      <h4 class="font-display text-lg font-medium">{item.name}</h4>
                      {item.note && (
                        <span class="inline-flex px-2 py-0.5 rounded text-[10px] font-semibold tracking-wide uppercase bg-[var(--color-brand-amber)]/15 text-[var(--color-brand-amber)] border border-[var(--color-brand-amber)]/25">
                          {item.note}
                        </span>
                      )}
                    </div>
                    {item.description && (
                      <p class="text-sm text-[var(--color-text-secondary)] mt-1">{item.description}</p>
                    )}
                  </div>
                  {item.price && (
                    <span class="text-sm text-[var(--color-accent)] whitespace-nowrap font-medium">{item.price}</span>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Sunday Gospel Brunch callout -->
      <div class="mt-16 p-6 md:p-8 bg-[var(--color-surface-card)] rounded-xl border border-[var(--color-border-subtle)]">
        <div class="flex flex-col md:flex-row md:items-center gap-6">
          <div class="flex-1">
            <span class="eyebrow" data-reveal>Every Sunday</span>
            <h3 class="font-display text-2xl font-semibold mt-1 mb-2" data-reveal>Sunday Gospel Brunch</h3>
            <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
              Sundays feature a special menu of soul food and gospel favorites — comforting, hearty dishes
              that resonate with the community's love for home cooking. Brunch served 11am–5pm with live
              gospel music from 1pm–5pm. Free champagne included while it lasts.
            </p>
          </div>
          <a href="/entertainment#brunch" class="shrink-0 inline-flex items-center px-6 py-3 bg-[var(--color-accent)] text-black font-semibold rounded-full hover:bg-[var(--color-accent-hover)] transition-colors text-sm">
            Brunch Details
          </a>
        </div>
      </div>

      <!-- Promotions -->
      <div class="mt-8 p-6 bg-[var(--color-surface-card)] rounded-xl border border-[var(--color-brand-amber)]/20 text-center">
        <span class="eyebrow" data-reveal>Special Offer</span>
        <h3 class="font-display text-xl font-semibold mb-2" data-reveal>Discounts</h3>
        <p class="text-sm text-[var(--color-text-secondary)]">10% off for seniors &amp; government workers with valid ID</p>
      </div>

      <!-- QR Code for digital menu access -->
      <div class="mt-8 p-6 bg-[var(--color-surface-card)] rounded-xl border border-[var(--color-border-subtle)] text-center" data-reveal>
        <span class="eyebrow">Scan the Menu</span>
        <h3 class="font-display text-xl font-semibold mt-1 mb-3">Digital Menu</h3>
        <div class="flex flex-col items-center">
          <img
            src="/media/qrcodes/qr-menu.png"
            alt="QR code for Lonell's menu"
            width="200"
            height="200"
            class="w-40 h-40 object-contain mb-3"
            loading="lazy"
          />
          <p class="text-xs text-[var(--color-text-muted)]">Scan with your phone camera to open this menu</p>
        </div>
      </div>

      <div class="mt-16">
        <span class="eyebrow" data-reveal>Inside Lonell's</span>
        <h2 class="font-display text-3xl md:text-4xl font-bold mb-6" data-reveal>Where We Serve</h2>
        <ImageLightboxGallery photos={menuPhotos} mobileCarousel />
      </div>
    </Section>
  </div>
</BaseLayout>

<style is:global>
  .menu-page-section.section-padding {
    padding-top: 1.25rem;
  }

  @media (min-width: 768px) {
    .menu-page-section.section-padding {
      padding-top: 1.5rem;
    }
  }

  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }

  [data-pill].active {
    background: var(--color-brand-amber);
    border-color: var(--color-brand-amber);
    color: #000;
  }

  [data-bento-card]:focus-visible,
  [data-pill]:focus-visible {
    outline: 2px solid var(--color-brand-amber);
    outline-offset: 2px;
  }

  @media (min-width: 768px) {
    #category-pill-bar {
      top: calc(4rem + 0px);
    }
  }
</style>

<script>
  (() => {
    const bentoGrid = document.getElementById("bento-grid");
    const pillBar = document.getElementById("category-pill-bar");
    const pills = document.querySelectorAll<HTMLButtonElement>("[data-pill]");
    const bentoCards = document.querySelectorAll<HTMLButtonElement>("[data-bento-card]");
    const sections = document.querySelectorAll<HTMLElement>("[data-category-section]");

    if (!bentoGrid || !pillBar || !pills.length || !sections.length) return;

    const pillNav = pillBar.querySelector<HTMLElement>("nav");

    const scrollToCategory = (id: string) => {
      const target = document.getElementById(id);
      if (!target) return;
      const headerH = window.innerWidth < 768 ? 56 : 64;
      const pillH = 56;
      const top = target.getBoundingClientRect().top + window.scrollY - headerH - pillH - 8;
      window.scrollTo({ top, behavior: "smooth" });
    };

    for (const card of bentoCards) {
      card.addEventListener("click", () => {
        const id = card.getAttribute("data-category");
        if (id) scrollToCategory(id);
      });
    }

    for (const pill of pills) {
      pill.addEventListener("click", () => {
        const id = pill.getAttribute("data-category");
        if (id) scrollToCategory(id);
      });
    }

    let bentoThreshold = bentoGrid.offsetTop + bentoGrid.offsetHeight;

    const scrollPillIntoView = (pill: HTMLButtonElement) => {
      if (!pillNav || window.innerWidth >= 1024) return;
      const padding = 16;
      const navRect = pillNav.getBoundingClientRect();
      const pillRect = pill.getBoundingClientRect();
      const overflowLeft = pillRect.left - navRect.left - padding;
      const overflowRight = pillRect.right - navRect.right + padding;

      if (overflowLeft < 0) {
        pillNav.scrollBy({ left: overflowLeft, behavior: "smooth" });
      } else if (overflowRight > 0) {
        pillNav.scrollBy({ left: overflowRight, behavior: "smooth" });
      }
    };

    let activeId: string | null = null;

    const updateActivePill = (id: string | null) => {
      if (id === activeId) return;
      activeId = id;
      let activePill: HTMLButtonElement | null = null;
      for (const pill of pills) {
        const match = pill.getAttribute("data-category") === id;
        pill.classList.toggle("active", match);
        pill.setAttribute("aria-selected", String(match));
        if (match) activePill = pill;
      }
      if (activePill) scrollPillIntoView(activePill);
    };

    const headerH = () => (window.innerWidth < 768 ? 56 : 64);
    const pillH = 56;

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

        if (visible.length > 0) {
          updateActivePill(visible[0].target.getAttribute("id"));
        }
      },
      {
        rootMargin: `-${headerH() + pillH}px 0px -50% 0px`,
        threshold: 0,
      }
    );

    for (const section of sections) {
      observer.observe(section);
    }

    let ticking2 = false;

    const updatePillBar = () => {
      const scrolledPast = window.scrollY + headerH() + pillH > bentoThreshold;
      pillBar.classList.toggle("opacity-0", !scrolledPast);
      pillBar.classList.toggle("pointer-events-none", !scrolledPast);
      ticking2 = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking2) {
          requestAnimationFrame(updatePillBar);
          ticking2 = true;
        }
      },
      { passive: true }
    );

    updatePillBar();

    let resizeTimer: ReturnType<typeof setTimeout> | undefined;
    let currentObserver = observer;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        currentObserver.disconnect();
        const newHeaderH = window.innerWidth < 768 ? 56 : 64;
        currentObserver = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((e) => e.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
            if (visible.length > 0) {
              updateActivePill(visible[0].target.getAttribute("id"));
            }
          },
          { rootMargin: `-${newHeaderH + pillH}px 0px -50% 0px`, threshold: 0 }
        );
        for (const section of sections) {
          currentObserver.observe(section);
        }
        bentoThreshold = bentoGrid.offsetTop + bentoGrid.offsetHeight;
        updatePillBar();
      }, 200);
    });
  })();
</script>
